@startuml

title C4 Level 4 - Code Diagram: CreateNewPasswordForm component (TODO)

start

:Render form\n- input: New password\n- input: Password confirmation\n- button: "Create new password";

:User enters new password + confirmation;

if (password !== confirmation?) then (yes)
  :Show error\n"Passwords must match";
endif

:User clicks "Create new password";

:POST /reset-password { token, newPassword };

if (response ok?) then (yes)
  :Reset all active sessions;
  :Redirect to /sign-in;
else (no)
  if (token invalid or expired?) then (yes)
    :Redirect to /resend-link\n"Looks like the verification link has expired";
  else (other)
    :Show generic error message;
  endif
endif

stop

@enduml
