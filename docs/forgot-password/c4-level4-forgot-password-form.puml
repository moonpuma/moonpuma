@startuml

title C4 Level 4 - Code Diagram: ForgotPasswordForm component (TODO)

start

:Render form\n- input: email\n- checkbox: reCAPTCHA\n- button: "Send Link"\n- link: "Back to Sign in";

:User enters email;

if (email loses focus & invalid?) then (yes)
  :Show error\n"The email must match the format example@example.com";
endif

if (email filled & valid & reCAPTCHA checked?) then (no)
  :Keep "Send Link" disabled;
else (yes)
  :Enable "Send Link";
endif

:User clicks "Send Link";

:POST /forgot-password { email, recaptchaToken };

if (response ok?) then (yes)
  :Show EmailSentModal\n"We have sent a link to confirm your email to ___email___";
else (no)
  if (status === 404?) then (yes)
    :Show message\n"User with this email doesn't exist";
  else (other)
    :Show generic error message;
  endif
endif

stop

@enduml
